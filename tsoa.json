{
  "entryFile": "src/infra/runtime/_http/index.ts",
  "compilerOptions": {
    "paths": {
      "@domain/*": ["./src/domain/*"],
      "@app/*": ["./src/app/*"],
      "@infra/*": ["./src/infra/*"],
      "@interface/*": ["./src/interface/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": ["src/**/*.controller.ts"],
  "spec": {
    "outputDirectory": "./generated",
    "basePath": "/api/v1",
    "specVersion": 3,
    "securityDefinitions": {
      "bearerAuth": {
        "type": "http",
        "in": "header",
        "name": "Authorization",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "routes": {
    "routesDir": "./generated",
    "basePath": "/api/v1",
    "authenticationModule": "./src/infra/config/tsoa-express-auth.ts"
  }
}
