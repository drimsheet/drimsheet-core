    varchar_3_ original_quantity_currency FK
    bigint remaining_quantity_amount
    bigint cost_basis_amount
    varchar_3_ cost_basis_currency FK
    bigint remaining_cost_basis_amount
    jsonb acquisition_rate
    timestamptz acquisition_date
    integer version
    timestamptz created_at
    timestamptz updated_at
}

core_user_auth {
    uuid created_by FK
    uuid user_id PK,FK
    varchar_200_ password
    integer failed_login_attempts
    _varchar___ strategies
    integer version
    timestamptz created_at
    timestamptz updated_at
}

core_user_preferences {
    uuid created_by FK
    uuid id PK,FK
    jsonb app_preferences
    uuid last_active_accounting_entity_id FK
    timestamptz created_at
    timestamptz updated_at
