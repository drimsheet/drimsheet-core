core_accounting_contexts {
    uuid created_by FK
    uuid id PK
    varchar_150_ name
    varchar_255_ description
    uuid accounting_entity_id FK
    varchar_15_ accounting_standard_code FK
    uuid fiscal_year_id FK
    uuid accounting_interval_id FK
    timestamptz created_at
    timestamptz updated_at
    timestamptz closed_at
}

core_accounting_entities {
    uuid created_by FK
    uuid id PK
    core_accounting_entity_type type
    varchar_255_ name
    uuid owner_id FK
    varchar_3_ functional_currency_code FK
    varchar_2_ jurisdiction_code FK
    timestamptz created_at
    timestamptz updated_at
    core_accounting_entity_status status
}

core_accounting_intervals {
    uuid id PK
    uuid accounting_entity_id FK
    uuid fiscal_year_id FK
    core_accounting_interval_unit unit
    integer count
    timestamptz start_date
    timestamptz end_date
    integer current_period_ordinal
    timestamptz next_period_start_date
    uuid created_by FK
    timestamptz created_at
    timestamptz updated_at
}

core_accounting_periods {
    uuid id PK
    uuid created_by FK
    varchar_100_ name
    uuid accounting_entity_id FK
    uuid interval_id FK
    integer ordinal
    timestamptz start_date
    timestamptz end_date
    core_accounting_period_status status
    timestamptz closed_at
    timestamptz created_at
    timestamptz updated_at
}

core_accounting_standards {
    uuid created_by FK
    varchar_15_ code PK
    varchar_100_ name
    varchar_200_ link
    boolean is_supported
    timestamptz created_at
    timestamptz updated_at
    timestamptz deleted_at
}

core_actors {
    uuid id PK
    varchar_20_ type
    varchar_319_ username
    varchar_319_ display_name
    uuid owner_actor_id FK
    varchar_64_ agent_name
    varchar_20_ status
    uuid created_by FK
    integer version
    timestamptz created_at
    timestamptz updated_at
}

core_bank_details {
    uuid created_by FK
    varchar_100_ bank_name PK
    varchar_34_ account_number PK
    varchar_100_ account_name
    varchar_2_ country_code
    uuid accounting_entity_id FK
    uuid ledger_account_id FK
    timestamptz created_at
    timestamptz updated_at
}

core_counterparties {
    uuid created_by FK
    uuid id PK
    uuid accounting_entity_id FK
    varchar_255_ name
    core_counter_party_status status
    core_counter_party_type type
    integer version
    jsonb meta
    timestamptz created_at
    timestamptz updated_at
}

core_currencies {
    uuid created_by FK
    varchar_3_ code PK
    varchar_5_ symbol
    varchar_50_ name
    smallint minor_unit
    timestamptz created_at
    timestamptz updated_at
    timestamptz deleted_at
}

core_currency_exchange_rates {
    uuid created_by FK
    bigint id PK
    varchar_7_ currency_pair
    varchar_3_ base_currency_code FK
    varchar_3_ target_currency_code FK
    numeric rate
    core_currency_exchange_rate_type type
    date as_of
    varchar_100_ source
    timestamptz created_at
}

core_fiscal_years {
    uuid created_by FK
    uuid id PK
    varchar_150_ name
    uuid accounting_entity_id FK
    core_fiscal_year_period_unit unit
    smallint count
    date start_date
    date end_date
    core_period_status status
    timestamptz closed_at
    timestamptz updated_at
}

core_journal_entries {
    uuid created_by FK
    uuid id PK
    uuid accounting_entity_id FK
    core_journal_entry_source_type source_type
    varchar_100_ memo
    core_journal_entry_status status
    date effective_date
    timestamptz posted_at
    timestamptz voided_at
    uuid voiding_entry_id FK
    integer version
    timestamptz created_at
    timestamptz updated_at
}

core_journal_entry_attachments {
    uuid journal_entry_id PK,FK
    jsonb data
    timestamptz created_at
    timestamptz updated_at
}

core_journal_lines {
    uuid created_by FK
    uuid id PK
    uuid entry_id FK
    uuid account_id FK
    uuid counterparty_id FK
    integer sequence_order
    bigint amount
    varchar_3_ currency_code FK
    jsonb exchange_rate
    bigint functional_amount
    varchar_3_ functional_currency_code FK
    core_journal_side side
    varchar_100_ description
    jsonb meta
    integer version
    timestamptz created_at
    timestamptz updated_at
}

core_jurisdiction_accounting_standards {
    varchar_2_ jurisdiction_code PK,FK
    varchar_15_ accounting_standard_code PK,FK
    core_accounting_entity_type accounting_entity_type PK
    timestamptz created_at
    timestamptz updated_at
}

core_jurisdictions {
    uuid created_by FK
    varchar_2_ code PK
    varchar_70_ name
    varchar_3_ currency_code FK
    timestamptz created_at
    timestamptz updated_at
    timestamptz deleted_at
}

core_ledger_account_balance_adjustments {
    uuid created_by FK
    uuid id PK
    uuid ledger_account_id FK
    bigint amount
    varchar_3_ currency_code FK
    bigint functional_amount
    varchar_3_ functional_currency_code FK
    uuid journal_entry_id FK
    core_ledger_account_balance_effect effect
    timestamptz created_at
}

core_ledger_account_balances {
    uuid created_by FK
    uuid ledger_account_id PK,FK
    uuid accounting_entity_id FK
    varchar_100_ account_materialized_path
    bigint amount
    varchar_3_ currency_code FK
    bigint functional_amount
    varchar_3_ functional_currency_code FK
    integer version
    timestamptz created_at
    timestamptz updated_at
}

core_ledger_accounts {
    uuid created_by FK
    uuid id PK
    varchar_6_ code
    varchar_100_ materialized_path
    uuid accounting_entity_id FK
    core_ledger_type type
    core_normal_balance_type normal_balance
    varchar sub_type
    varchar behavior
    boolean is_control_account
    uuid control_account_id FK
    varchar_100_ name
    varchar_3_ currency_code FK
    core_ledger_account_status status
    core_contra_account_rule contra_account_rule
    core_adjunct_account_rule adjunct_account_rule
    date opening_balance_date
    jsonb meta
    integer version
    timestamptz created_at
    timestamptz updated_at
    timestamptz deleted_at
}

core_outbox {
    uuid id PK
    varchar_255_ correlation_id
    varchar_255_ type
    jsonb data
    timestamptz created_at
}

core_reporting_contexts {
    uuid created_by FK
    uuid id PK
    varchar_150_ name
    varchar_255_ description
    uuid accounting_entity_id FK
    varchar_3_ reporting_currency_code FK
    uuid accounting_context_id FK
    uuid reporting_interval_id FK
    timestamptz created_at
    timestamptz updated_at
    timestamptz closed_at
}

core_reporting_intervals {
    uuid id PK
    uuid accounting_entity_id FK
    uuid fiscal_year_id FK
    core_reporting_interval_unit unit
    integer count
    timestamptz start_date
    timestamptz end_date
    integer current_period_ordinal
    timestamptz next_period_start_date
    uuid created_by FK
    timestamptz created_at
    timestamptz updated_at
}

core_reporting_periods {
    uuid created_by FK
    uuid id PK
    varchar_100_ name
    uuid accounting_entity_id FK
    uuid interval_id FK
