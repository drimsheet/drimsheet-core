erDiagram
%% Accounting/reporting definitions reflect repository migrations 0021-0031.
%% Interval and child-period ranges are [start_date, end_date); fiscal-year dates remain inclusive.

audit_accounting_context_history {
    bigint id PK
    uuid accounting_context_id
    uuid accounting_entity_id
    uuid actor_id FK
    uuid on_behalf_of FK
    varchar_50_ action
    jsonb diff
    varchar_255_ correlation_id
    timestamptz occurred_at
    timestamptz recorded_at
}

