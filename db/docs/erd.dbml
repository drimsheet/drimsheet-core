Table core.counterparties {
  id uuid [pk, not null, default: `uuid_generate_v4()`]
  accounting_entity_id uuid [not null]
  name varchar(255) [not null]
  status core.counter_party_status [not null]
  type core.counter_party_type [not null]
  meta jsonb [not null, default: `'{}'`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (accounting_entity_id) [name: 'counterparties_accounting_entity_id_idx']
  }

  checks {
    `NOT meta ? 'contractor'::text OR COALESCE(jsonb_typeof(meta -> 'contractor'::text) = 'object'::text, false)` [name: 'counterparties_contractor_meta_check']
    `NOT meta ? 'employer'::text OR COALESCE(jsonb_typeof(meta -> 'employer'::text) = 'object'::text, false)` [name: 'counterparties_employer_meta_check']
    `jsonb_typeof(meta) = 'object'::text AND (meta - ARRAY['employer'::text, 'vendor'::text, 'contractor'::text]) = '{}'::jsonb` [name: 'counterparties_meta_check']
    `NOT meta ? 'vendor'::text OR COALESCE(jsonb_typeof(meta -> 'vendor'::text) = 'object'::text, false)` [name: 'counterparties_vendor_meta_check']
  }

  Note: 'Schema: core'
}

