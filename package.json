{
  "name": "drimsheet-core",
  "version": "0.1.0-alpha.1",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "pretest": "npm run test:types",
    "test": "jest",
    "test:lint-rules": "node --test scripts/__specs__/eslint-rules.spec.mjs",
    "test:types": "tsc -p tsconfig.test.json --noEmit",
    "pretest:http:coverage": "npm run test:types",
    "test:http:coverage": "jest test/http --coverage --runInBand --collectCoverageFrom='src/interface/http/controllers/**/*.ts' --coverageThreshold='{\"src/interface/http/controllers/**/*.ts\":{\"branches\":100,\"functions\":100,\"lines\":100,\"statements\":100}}'",
    "test:names": "node scripts/check-test-file-names.mjs",
    "test:ci": "bash scripts/test-ci.sh",
    "test:db:reset": "bash scripts/reset-test-db.sh",
    "ingest:exchange-rates": "node ./dist/src/infra/runtime/_bootstrap/exchange-rate-ingestion.bootstrap.js",
    "start": "npm run db:migrate up && node ./dist/src/infra/runtime/_bootstrap/index.js",
    "start:test": "bash scripts/test.sh",
    "setup:test:db": "bash scripts/setup-test-db.sh",
    "dev": "bash scripts/dev.sh",
    "format:all": "prettier --write \"src/**/*.{ts,js,json,md}\" \"test/**/*.ts\"",
    "format:changed": "prettier --write --cache .",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" && node scripts/check-import-path-policy.mjs",
    "build": "node scripts/clean-dist.mjs && tsoa spec-and-routes && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node scripts/check-built-import-aliases.mjs && node scripts/upload-sentry-sourcemaps.mjs",
    "build:routes": "tsoa spec-and-routes ",
    "drizzle:pull": "drizzle-kit pull",
    "sentry:sourcemaps": "node scripts/upload-sentry-sourcemaps.mjs",
    "prepare": "husky",
    "adr:add": "tsx scripts/add-adr.ts",
    "adr:remove": "tsx scripts/remove-adr.ts",
    "adr:rename": "tsx scripts/rename-adr.ts",
    "adr:sync": "tsx scripts/sync-adr.ts",
    "mjml:build": "tsx scripts/mjml-to-ts.ts",
    "export:errors": "tsx scripts/export-error-keys.ts",
    "json-contract-to-ts": "tsx scripts/json-contract-to-ts.ts",
    "db:docs": "node scripts/generate-db-docs.js",
    "db:migrate": "tsx ./node_modules/.bin/node-pg-migrate -j ts -m ./db/migrations -d POSTGRES_URL --migration-filename-format index",
    "db:sync": "npm run db:migrate up && npm run drizzle:pull",
    "db:reset": "npm run db:migrate down 1000 && npm run db:sync"
  },
  "lint-staged": {
    "*.{ts,js,json,md}": "prettier --write"
  },
  "keywords": [],
  "author": "Osahon Oboite",
  "description": "This repo contains the server-side source code for Drimsheet's bookkeeping and tax app.",
  "bin": {
    "drimsheet-core": "scripts/api-gen.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.4",
    "@commitlint/config-conventional": "^20.4.4",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@sentry/cli": "^3.6.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.9.1",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pg": "^8.18.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.7.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.0.2",
    "husky": "^9.1.7",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "jest": "^30.3.0",
    "node-pg-migrate": "^9.0.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "swagger-typescript-api": "^13.6.3",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1118.0",
    "@aws-sdk/s3-request-presigner": "^3.1118.0",
    "@bull-board/api": "^6.20.7",
    "@bull-board/express": "^6.20.7",
    "@launchdarkly/node-server-sdk": "^9.13.0",
    "@logtail/node": "^0.5.8",
    "@logtail/winston": "^0.5.8",
    "@modelcontextprotocol/express": "^2.0.1",
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.220.0",
    "@opentelemetry/otlp-exporter-base": "^0.220.0",
    "@opentelemetry/resources": "2.9.0",
    "@opentelemetry/sdk-metrics": "^2.9.0",
    "@sentry/node": "^10.43.0",
    "axios": "^1.14.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.73.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.20",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.23",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.20.0",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^7.0.0-alpha.0",
    "uuid": "^11.1.1",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  }
}
